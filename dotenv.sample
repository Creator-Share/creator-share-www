NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_BASE_URL=https://localhost:3000/

# Public frontend exposure (dollars in cents integer string) to allow UI to honor/lock the amount
NEXT_PUBLIC_SPONSORSHIP_GOAL=

# Reservation timeout in minutes (how long a child stays reserved when someone starts sponsoring)
RESERVATION_TIMEOUT_MINUTES=
NEXT_PUBLIC_RESERVATION_TIMEOUT_MINUTES=

# PayPal Integration (optional - PayPal is enabled when NEXT_PUBLIC_PAYPAL_CLIENT_ID is set)
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_API_URL=https://api-m.sandbox.paypal.com
# PAYPAL_WEBHOOK_ID=

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email
EMAIL_HOST=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_PORT=587
EMAIL_SECURE=true
EMAIL_FROM="Creator Share" <noreply@creatorshare.com>


# AI Proofreading (Google Gemini)
# Get your free API key from: https://aistudio.google.com/app/apikey
# Free tier: 15 requests/minute, 1,500 requests/day
GEMINI_API_KEY=
