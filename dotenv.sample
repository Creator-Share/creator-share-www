NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_URL=
NEXT_PUBLIC_BASE_URL=https://localhost:3000/

# Multi-region Stripe (optional — leave commented out to run single-account).
# When enabled, each region has its own Stripe account/dashboard; new
# subscriptions and partnerships are stamped with `payment_region` so
# cancel/refund/portal flows route to the correct account.
#
# STRIPE_DEFAULT_REGION controls which region new checkouts use until
# explicit routing by beneficiary (Phase 3) lands. The legacy unsuffixed
# vars above act as fallbacks for the default region during migration.
#
# STRIPE_DEFAULT_REGION=us
# STRIPE_SECRET_KEY_US=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_US=
# STRIPE_WEBHOOK_SECRET_US=
# STRIPE_PORTAL_URL_US=
# NEXT_PUBLIC_STRIPE_PORTAL_URL_US=
# STRIPE_SECRET_KEY_UK=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_UK=
# STRIPE_WEBHOOK_SECRET_UK=
# STRIPE_PORTAL_URL_UK=
# NEXT_PUBLIC_STRIPE_PORTAL_URL_UK=
#
# NEXT_PUBLIC_STRIPE_PORTAL_URL_* powers the public Footer / FAQ / About
# "Manage Subscription" links. Server-side STRIPE_PORTAL_URL_* powers email
# template links. Set both in production so the in-app link and the email
# link agree.

# DEPRECATED — Global sponsorship amount override (dollars in cents integer string).
# Superseded by per-type vars below (NEXT_PUBLIC_SPONSORSHIP_AMOUNT_*).
# Leave empty unless you need a single hardcoded amount for all types.
NEXT_PUBLIC_SPONSORSHIP_GOAL=

# Sponsorship amounts per beneficiary type (in cents, e.g. 3333 = $33.33)
NEXT_PUBLIC_SPONSORSHIP_AMOUNT_CHILD_LABORER=3333
NEXT_PUBLIC_SPONSORSHIP_AMOUNT_SPECIAL_NEEDS=5000
NEXT_PUBLIC_SPONSORSHIP_AMOUNT_ANIMAL=2500

# Reservation timeout in minutes (how long a child stays reserved when someone starts sponsoring)
RESERVATION_TIMEOUT_MINUTES=
NEXT_PUBLIC_RESERVATION_TIMEOUT_MINUTES=

# PayPal Integration (optional - PayPal is enabled when NEXT_PUBLIC_PAYPAL_CLIENT_ID is set)
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_API_URL=https://api-m.sandbox.paypal.com
# PAYPAL_WEBHOOK_ID=

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email
EMAIL_HOST=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_PORT=587
EMAIL_SECURE=true
EMAIL_FROM="Creator Share" <noreply@creatorshare.com>


# AI Proofreading (OpenAI-Compatible API)
# Supports: OpenAI, Azure OpenAI, OpenRouter, Anthropic (via proxy), local models (LM Studio, Ollama), etc.
# 
# Required environment variables:
LLM_API_KEY=           # Your API key for the LLM provider
LLM_API_HOST=          # API base path (see examples below - NO trailing slash)
# 
# Optional:
LLM_MODEL=             # Model name (defaults to gpt-4o-mini if not specified)
#
# Example configurations (openai-edge library appends /chat/completions):
# OpenAI:         LLM_API_HOST=https://api.openai.com/v1
# OpenRouter:     LLM_API_HOST=https://openrouter.ai/api/v1
# Azure OpenAI:   LLM_API_HOST=https://{resource}.openai.azure.com/openai/deployments/{deployment}
# Local (Ollama): LLM_API_HOST=http://localhost:11434/v1
# Local (LM Studio): LLM_API_HOST=http://localhost:1234/v1
